# Django Environment Variables Example
# Copy this file to .env and fill in your production values

# ── Security ──
# Set to false in production
DJANGO_DEBUG=False
# Generate a strong, random 50-character string
DJANGO_SECRET_KEY=your-production-secret-key-here
# Your backend URL, e.g., learntolever-api.onrender.com
DJANGO_ALLOWED_HOSTS=learntolever-api.onrender.com,localhost,127.0.0.1

# ── CORS ──
# The URL where your React frontend is hosted
FRONTEND_URL=https://your-frontend-project.vercel.app

# ── Database ──
# Connection string provided by Render/Neon/Railway
DATABASE_URL=postgres://user:password@hostname:5432/dbname
